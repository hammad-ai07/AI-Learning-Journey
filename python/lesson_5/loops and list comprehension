numbers = [3, 7, 12, 18, 21, 25, 30, 42, 55, 60]

# Q1 - Print every number
for num in numbers:
    print(num)

# Q2 - Print even numbers
for num in numbers:
    if num % 2 == 0:
        print(num)

# Q3 - Calculate sum
total = 0
for num in numbers:
    total += num
print("Total:", total)

# Q4 - Numbers greater than 20
greater_than_20 = []
for num in numbers:
    if num > 20:
        greater_than_20.append(num)
print("Greater than 20:", greater_than_20)

# Q5 - Squares using a for loop
squares = []
for num in numbers:
    squares.append(num ** 2)
print("Squares:", squares)

# Q6 - Squares using list comprehension
squares_comprehension = [num ** 2 for num in numbers]
print("Squares (comprehension):", squares_comprehension)

# Q7 - Even numbers using list comprehension
even_numbers = [num for num in numbers if num % 2 == 0]
print("Even numbers:", even_numbers)

# Q8 - Numbers greater than 10 AND less than 50
selected_numbers = [num for num in numbers if num > 10 and num < 50]
print("10 < number < 50:", selected_numbers)

# Q9 - Count numbers greater than 20
count = 0
for num in numbers:
    if num > 20:
        count += 1
print("Count:", count)

# Q10 - Even numbers ke squares
even_squares = [num ** 2 for num in numbers if num % 2 == 0]
print("Even squares:", even_squares)
